:root {
  --bg: #0f1117;
  --panel: #171a23;
  --panel-2: #1e2230;
  --border: #2a2f3f;
  --text: #eef0f5;
  --muted: #8b90a3;
  --accent: #6c5ce7;
  --accent-2: #00d4ff;
  --danger: #ff5470;
  --warn: #ffb020;
  --exact: #ff5470;
  --near: #ffb020;
  --radius: 14px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  background: radial-gradient(circle at 20% -10%, #1c1f2e 0%, var(--bg) 55%);
  color: var(--text);
  min-height: 100vh;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 32px;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  background: rgba(15, 17, 23, 0.85);
  backdrop-filter: blur(8px);
  z-index: 10;
}

.brand {
  font-size: 1.25rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-icon {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-size: 1.4rem;
}

.stats {
  color: var(--muted);
  font-size: 0.9rem;
}

main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 32px 24px 80px;
}

.upload-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
}

.drop-zone {
  border: 2px dashed var(--border);
  border-radius: var(--radius);
  padding: 48px 20px;
  text-align: center;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
}

.drop-zone.dragover {
  border-color: var(--accent-2);
  background: rgba(0, 212, 255, 0.06);
}

.drop-icon {
  font-size: 2rem;
  color: var(--accent-2);
  margin-bottom: 8px;
}

.hint {
  color: var(--muted);
  font-size: 0.85rem;
  margin-top: 4px;
}

.controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20px;
  flex-wrap: wrap;
  gap: 16px;
}

.threshold-label {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  font-size: 0.9rem;
}

#threshold {
  accent-color: var(--accent);
}

.buttons {
  display: flex;
  gap: 12px;
}

.btn {
  border: none;
  border-radius: 10px;
  padding: 11px 20px;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
}

.btn:active { transform: scale(0.97); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }

.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: white;
  box-shadow: 0 4px 20px rgba(108, 92, 231, 0.35);
}

.btn-danger {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--muted);
}

.btn-danger:hover { color: var(--danger); border-color: var(--danger); }

.loading {
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: center;
  padding: 40px 0;
  color: var(--muted);
}

.spinner {
  width: 22px;
  height: 22px;
  border: 3px solid var(--border);
  border-top-color: var(--accent-2);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.hidden { display: none !important; }

.summary {
  margin: 28px 0 18px;
  color: var(--muted);
  font-size: 0.95rem;
}

.summary strong { color: var(--text); }

.group-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px;
  margin-bottom: 18px;
}

.group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.badge {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.badge-exact {
  background: rgba(255, 84, 112, 0.15);
  color: var(--exact);
  border: 1px solid rgba(255, 84, 112, 0.4);
}

.badge-near {
  background: rgba(255, 176, 32, 0.15);
  color: var(--warn);
  border: 1px solid rgba(255, 176, 32, 0.4);
}

.group-meta {
  color: var(--muted);
  font-size: 0.85rem;
}

.image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.thumb {
  width: 130px;
}

.thumb img {
  width: 130px;
  height: 130px;
  object-fit: cover;
  border-radius: 10px;
  border: 1px solid var(--border);
  display: block;
}

.thumb-name {
  font-size: 0.75rem;
  color: var(--muted);
  margin-top: 6px;
  word-break: break-all;
}

.section-title {
  margin: 32px 0 14px;
  color: var(--muted);
  font-weight: 600;
  font-size: 0.95rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.unique-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}
